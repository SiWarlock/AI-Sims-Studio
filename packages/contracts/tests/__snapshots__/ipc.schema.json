          "succeeded",
          "failed",
          "waiting-for-user",
          "cancelled",
          "retrying",
          "skipped"
        ],
        "title": "StepState",
        "type": "string"
      },
      "StepStateEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "const": "step-state",
            "default": "step-state",
            "title": "Event",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "runId": {
            "title": "Runid",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/StepState"
          },
          "stepId": {
            "title": "Stepid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "runId",
          "stepId",
          "status"
        ],
        "title": "StepStateEvent",
        "type": "object"
      },
      "ValidationEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "const": "validation",
