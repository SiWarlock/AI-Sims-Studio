        "additionalProperties": false,
        "description": "A color/texture preset of one mesh (Sims-native, embedded under AssetVariant).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isDefault": {
            "default": false,
            "title": "Isdefault",
            "type": "boolean"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "texturePaths": {
            "items": {
              "type": "string"
            },
            "title": "Texturepaths",
            "type": "array"
          },
          "thumbnailPath": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Thumbnailpath"
          },
          "variantId": {
            "title": "Variantid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "variantId",
          "label"
        ],
        "title": "Swatch",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A selectable realized item. Requires lineage refs (conceptRef + meshRef) and \u22651 Swatch.",
    "properties": {
      "conceptRef": {
        "title": "Conceptref",
        "type": "string"
      },
      "exportReadiness": {
        "default": false,
        "title": "Exportreadiness",
        "type": "boolean"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "itemId": {
        "title": "Itemid",
        "type": "string"
      },
      "meshRef": {
        "title": "Meshref",
        "type": "string"
      },
      "previewRefs": {
        "items": {
          "type": "string"
        },
        "title": "Previewrefs",
        "type": "array"
      },
      "schemaVersion": {
        "default": 1,
        "title": "Schemaversion",
        "type": "integer"
      },
      "state": {
        "$ref": "#/$defs/AssetVariantState",
        "default": "candidate"
      },
      "swatches": {
        "items": {
          "$ref": "#/$defs/Swatch"
        },
        "minItems": 1,
        "title": "Swatches",
        "type": "array"
      }
    },
    "required": [
      "id",
      "itemId",
      "conceptRef",
      "meshRef",
      "swatches"
