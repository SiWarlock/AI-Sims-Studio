          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "itemId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Itemid"
          },
          "runId": {
            "title": "Runid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "runId",
          "gate"
        ],
        "title": "GateNeededEvent",
        "type": "object"
      },
      "LogEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "const": "log",
