  "RegistryFinding": {
    "$defs": {
      "ErrorCategory": {
        "description": "Closed coarse error-category set (\u00a717) \u2014 the routing/telemetry grouping for a code.",
        "enum": [
          "provider",
          "network",
          "validation",
          "geometry",
          "packaging",
          "budget",
          "system"
        ],
        "title": "ErrorCategory",
        "type": "string"
      },
      "ErrorCode": {
        "description": "Closed, stable per-stage error code set (\u00a717).\n\nWithin-version PRODUCER contract: the sidecar emits only these codes; an out-of-enum\nvalue is rejected at the boundary (deterministic validation, safety rule 6).\n\nCONSUMERS (the 0.6 TS codegen type + engine/UI switch logic) MUST treat any unrecognized\ncode as ``SYSTEM`` for forward compatibility, so a future additive split is non-breaking;\nthat tolerance is tested where consumers live, not here.\n\n``PROVIDER_AUTH_QUOTA`` groups auth (401) and quota/billing (402); the 401-vs-402\ndistinction is preserved in ``ErrorEnvelope.maintainerDetail`` at emit time.",
        "enum": [
          "PROVIDER_TIMEOUT",
          "PROVIDER_RATE_LIMIT",
          "PROVIDER_AUTH_QUOTA",
          "PROVIDER_OUTAGE",
          "ARTIFACT_EXPIRED",
          "MALFORMED_OUTPUT",
          "MESH_QA_FAILED",
          "GEOM_EXPORT_FAILED",
          "DBPF_WRITE_FAILED",
          "TEST_INSTALL_FAILED",
          "DISK_FULL",
          "VALIDATION_FAILED",
          "SYSTEM"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "description": "Frozen error contract (\u00a717, \u00a74): SSE ``error``, ``Step.error``, ``ValidationResult``.\n\nField names are camelCase to match the JSON/TS wire form (\u00a74) \u2014 no alias indirection.\n``extra=\"forbid\"`` rejects unknown fields at the boundary (frozen \u00a72.5-seam, safety rule 6).",
        "properties": {
          "category": {
            "$ref": "#/$defs/ErrorCategory"
          },
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "creatorMessage": {
            "title": "Creatormessage",
            "type": "string"
          },
          "maintainerDetail": {
            "title": "Maintainerdetail",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "suggestedAction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Suggestedaction"
          },
          "traceRef": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Traceref"
          }
        },
        "required": [
          "code",
          "category",
          "retryable",
          "creatorMessage",
          "maintainerDetail"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "RegistryIssue": {
        "description": "The closed set of load-time registry issues (structural only \u2014 Q2 scope).",
        "enum": [
          "missing-version",
          "duplicate-key",
          "malformed-entry"
        ],
        "title": "RegistryIssue",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "A load-time registry validation finding: a granular registry-local ``issue`` + the \u00a717\n``ErrorEnvelope`` (so the 0.7 store loader surfaces it through the standard error channel);\n``entryKey`` names the offending entry where applicable.",
    "properties": {
      "entryKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Entrykey"
      },
      "error": {
        "$ref": "#/$defs/ErrorEnvelope"
      },
      "issue": {
        "$ref": "#/$defs/RegistryIssue"
      }
    },
    "required": [
      "issue",
      "error"
    ],
    "title": "RegistryFinding",
    "type": "object"
  },
