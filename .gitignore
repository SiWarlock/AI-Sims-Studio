# =============================================================================
# AI Sims Creator — .gitignore
# Stack: Tauri v2 (Rust) + React/TypeScript (Vite) + Python 3.12 sidecar
# =============================================================================

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# =============================================================================
# Python — sidecar
# =============================================================================

# Virtual environments
sidecar/.venv/
sidecar/venv/
.venv/
venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
wheels/
*.whl
sdist/
.eggs/
pip-wheel-metadata/
share/python-wheels/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
nosetests.xml
pytest-report.html

# Type checking
.mypy_cache/
.pytype/
.pyre/
pyrightconfig.json

# Linting
.ruff_cache/

# Jupyter (just in case)
.ipynb_checkpoints/
*.ipynb

# =============================================================================
# Node / TypeScript — frontend
# =============================================================================
node_modules/
.npm/
.pnpm-store/
.yarn/

# Build output
frontend/dist/
frontend/.vite/
frontend/build/

# TypeScript build info
*.tsbuildinfo

# Environment files (never commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============================================================================
# Tauri / Rust
# =============================================================================

# Rust build artifacts
frontend/src-tauri/target/
target/

# Tauri generated files
frontend/src-tauri/gen/
frontend/src-tauri/WixTools/

# =============================================================================
# Generated files — let scripts/generate_types.py manage these
# (shared-types/ is committed; intermediate artifacts are not)
# =============================================================================
/tmp/aisc-*.log
/tmp/aisc-*.tmp

# =============================================================================
# Git LFS — template binary files ARE tracked, but make sure large binaries
# not intended for LFS don't sneak in
# =============================================================================
# (templates/*.glb and templates/*.blend are tracked via Git LFS — see .gitattributes)

# =============================================================================
# Sims 4 / DBPF — never commit game files or test packages into the repo
# =============================================================================
*.package
*.trayitem
*.sgi

# Test fixture .package files are allowed under tests/fixtures/ only
!sidecar/tests/fixtures/**/*.package

# =============================================================================
# Blender
# =============================================================================
*.blend1
*.blend2
*.blend@
*.blend.bak

# =============================================================================
# Secrets and credentials — non-negotiable
# =============================================================================
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
secrets.json
secrets.toml
*_secret.*
*_secrets.*
api_keys.*

# =============================================================================
# IDE and editors
# =============================================================================

# VSCode (commit .vscode/extensions.json and .vscode/launch.json if useful,
# but not settings that are personal)
.vscode/settings.json
.vscode/tasks.json
.vscode/.ropeproject

# JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# =============================================================================
# OS — Windows (maintainer platform)
# =============================================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# =============================================================================
# pre-commit framework
# =============================================================================
.pre-commit-hooks.yaml

# =============================================================================
# Claude Code
# =============================================================================
# Local settings override (personal, not committed)
.claude/settings.local.json

# Agent memory directories (if using persistent memory)
.claude/agent-memory/

# =============================================================================
# CI / build artifacts
# =============================================================================
*.dmg
*.app
*.pkg
*.msi
*.exe
*.deb
*.rpm
*.tar.gz
*.zip

# Keep installer artifacts out of the repo — they belong in GitHub Releases
!.github/

# =============================================================================
# Logs
# =============================================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Misc
# =============================================================================
# Compressed files (shouldn't be in source control)
*.7z
*.gz
*.rar
*.tar
*.bz2
*.xz

# Backup files
*.bak
*.orig
*.tmp