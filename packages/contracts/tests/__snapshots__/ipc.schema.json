        ],
        "title": "LogLevel",
        "type": "string"
      },
      "ProgressEvent": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "const": "progress",
            "default": "progress",
            "title": "Event",
            "type": "string"
          },
          "fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fraction",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
